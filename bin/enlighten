#!/usr/bin/env node
const fs = require("fs");
const path = require("path");
const os = require("os");
const { execSync } = require("child_process");

const { EnlightenScanner } = require("../skills/enlighten-installer/scripts/scan-repo");
const { ScriptAdapter } = require("../skills/enlighten-installer/scripts/adapt-install");

class EnlightCLI {
  constructor() {
    this.version = "1.0.2";
    this.cacheDir = path.join(os.homedir(), ".enlight", "cache");
    this.installedRegistry = path.join(this.cacheDir, "installed.json");
    this.ensureDirs();
  }

  ensureDirs() {
    if (!fs.existsSync(this.cacheDir)) {
      fs.mkdirSync(this.cacheDir, { recursive: true });
    }
    if (!fs.existsSync(this.installedRegistry)) {
      fs.writeFileSync(this.installedRegistry, JSON.stringify({ installations: [] }, null, 2));
    }
  }

  install(repoUrl, options) {
    console.log("\nEnlight v" + this.version + "\n");
    console.log("Installing: " + repoUrl + "\n");
    
    console.log("Step 1: Scanning repository...");
    const scanner = new EnlightenScanner({ dryRun: options.dryRun });
    let diagnostics;
    try {
      const tempDir = "/tmp/enlight-scan-" + Date.now();
      const repoCmd = "git clone --depth 1 " + repoUrl + " " + tempDir;
      execSync(repoCmd, { stdio: "pipe" });
      diagnostics = scanner.scanRepo(tempDir);
    } catch (e) {
      diagnostics = {
        status: "scanned",
        repository: repoUrl,
        detected: { language: "unknown", framework: "unknown" },
        profile: { recommended: "developer" }
      };
    }
    
    console.log("  Language: " + (diagnostics.language || diagnostics.detected.language));
    console.log("  Framework: " + (diagnostics.framework || diagnostics.detected.framework));
    console.log("  Profile: " + diagnostics.profile.recommended + "\n");
    
    const adapter = new ScriptAdapter(options);
    const adapted = adapter.adapt(diagnostics);
    console.log("  OS: " + adapted.os);
    console.log("  Harness: " + adapted.harness + "\n");
    
    if (options.dryRun) {
      console.log("DRY RUN - no changes made\n");
      return { status: "dry_run" };
    }
    
    console.log("Step 2: Installing...\n");
    const identifier = this.getIdentifier(repoUrl);
    this.registerInstallation(repoUrl, identifier, adapted);
    console.log("\nInstall complete!\n");
    
    return { status: "success", identifier };
  }

  diagnose(repoUrl) {
    const scanner = new EnlightenScanner();
    try {
      const tempDir = "/tmp/enlight-diag-" + Date.now();
      execSync("git clone --depth 1 " + repoUrl + " " + tempDir, { stdio: "pipe", timeout: 30000 });
      const result = scanner.scanRepo(tempDir);
      console.log(JSON.stringify(result, null, 2));
    } catch (e) {
      console.log(JSON.stringify({ error: e.message }, null, 2));
    }
  }

  getInstalled() {
    try {
      const data = JSON.parse(fs.readFileSync(this.installedRegistry, "utf8"));
      return data.installations || [];
    } catch {
      return [];
    }
  }

  registerInstallation(repoUrl, identifier, info) {
    const installed = this.getInstalled();
    installed.push({
      identifier,
      repo_url: repoUrl,
      installed_at: new Date().toISOString(),
      profile: info.profile,
      harness: info.harness,
      version: this.version
    });
    fs.writeFileSync(this.installedRegistry, JSON.stringify({ installations: installed }, null, 2));
  }

  getIdentifier(repoUrl) {
    const match = repoUrl.match(/github\.com\/([^/]+\/[^/]+)/);
    if (match) {
      return match[1].replace(/[^a-zA-Z0-9-]/g, "-").replace(/-+$/, "");
    }
    return "install-" + Date.now();
  }
}

const cli = new EnlightCLI();
const args = process.argv.slice(2);

if (args.length === 0) {
  console.log("\nEnlight v" + cli.version);
  console.log("\nUSAGE:");
  console.log("    enlighten install <repo-url>    Install a GitHub repository");
  console.log("    enlighten diagnose <repo-url>   Analyze without installing");
  console.log("    enlighten --help                Show this help");
  process.exit(0);
}

const cmd = args[0].toLowerCase();

if (cmd === "install") {
  if (args.length < 2) {
    console.error("Error: repository URL required");
    process.exit(1);
  }
  cli.install(args[1], { dryRun: args.includes("--dry-run") });
} else if (cmd === "diagnose") {
  if (args.length < 2) {
    console.error("Error: repository URL required");
    process.exit(1);
  }
  cli.diagnose(args[1]);
} else if (cmd === "help" || cmd === "--help") {
  console.log("\nEnlight v" + cli.version);
  console.log("\nUSAGE:");
  console.log("    enlighten install <repo-url>    Install a GitHub repository");
  console.log("    enlighten diagnose <repo-url>   Analyze without installing");
  console.log("    enlighten --help                Show this help");
} else {
  console.error("Unknown command: " + cmd);
}