#!/usr/bin/env node
/**
 * enlighten - Universal GitHub Repository & Skill Installer for AI Agent Harnesses
 * Full lifecycle: install -> diagnose -> list -> uninstall
 * Auto-registers skills across Antigravity, Open Agents, Claude Code, Hermes, OpenCode, Codex, Cursor
 */

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execSync } = require('child_process');

const { EnlightenScanner } = require('../skills/enlighten-installer/scripts/scan-repo');
const { ScriptAdapter } = require('../skills/enlighten-installer/scripts/adapt-install');
const { SkillRegistry } = require('../skills/enlighten-installer/scripts/skill-registry');

class EnlightCLI {
  constructor(options = {}) {
    let pkg = { version: '1.0.8' };
    try {
      pkg = require('../package.json');
    } catch {}
    this.version = pkg.version;
    this.homedir = options.homedir || os.homedir();
    this.enlightenDir = path.join(this.homedir, '.enlighten');
    this.reposDir = path.join(this.enlightenDir, 'repos');
    this.cacheDir = path.join(this.enlightenDir, 'cache');
    this.installedRegistry = path.join(this.cacheDir, 'installed.json');

    this.scanner = new EnlightenScanner({ dryRun: options.dryRun });
    this.adapter = new ScriptAdapter(options);
    this.skillRegistry = new SkillRegistry({ homedir: this.homedir, dryRun: options.dryRun });

    this.ensureDirs();
  }

  ensureDirs() {
    for (const dir of [this.enlightenDir, this.reposDir, this.cacheDir]) {
      if (!fs.existsSync(dir)) {
        try {
          fs.mkdirSync(dir, { recursive: true });
        } catch {}
      }
    }
    if (!fs.existsSync(this.installedRegistry)) {
      try {
        fs.writeFileSync(this.installedRegistry, JSON.stringify({ installations: [] }, null, 2));
      } catch {}
    }
  }

  /**
   * Normalize any repo input (URL, shorthand, or local path)
   */
  normalizeRepoUrl(input) {
    let clean = input.trim();
    // Shorthand e.g. vercel-labs/agent-skills
    if (/^[a-zA-Z0-9_.-]+\/[a-zA-Z0-9_.-]+$/.test(clean)) {
      clean = `https://github.com/${clean}.git`;
    } else if (clean.startsWith('github.com/')) {
      clean = `https://${clean}`;
    }

    let owner = 'unknown';
    let repoName = 'repo-' + Date.now();

    const match = clean.match(/github\.com[/:]([^/]+)\/([^/.]+)(?:\.git)?/i);
    if (match) {
      owner = match[1];
      repoName = match[2];
    } else if (fs.existsSync(clean)) {
      owner = 'local';
      repoName = path.basename(path.resolve(clean));
    }

    const identifier = `${owner}-${repoName}`.replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase();

    return {
      url: clean,
      owner,
      repoName,
      identifier
    };
  }

  getInstalled() {
    try {
      if (!fs.existsSync(this.installedRegistry)) return [];
      const data = JSON.parse(fs.readFileSync(this.installedRegistry, 'utf8'));
      return data.installations || [];
    } catch {
      return [];
    }
  }

  saveInstalled(list) {
    try {
      fs.writeFileSync(this.installedRegistry, JSON.stringify({ installations: list }, null, 2));
    } catch {}
  }

  /**
   * Expose discovered binaries to ~/.local/bin
   */
  exposeBinaries(targetDir, binaries) {
    const localBin = path.join(this.homedir, '.local', 'bin');
    if (!fs.existsSync(localBin)) {
      try {
        fs.mkdirSync(localBin, { recursive: true });
      } catch {}
    }

    const exposed = [];
    // 1. package.json bin
    const pkgPath = path.join(targetDir, 'package.json');
    if (fs.existsSync(pkgPath)) {
      try {
        const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
        if (typeof pkg.bin === 'string') {
          const binName = pkg.name || path.basename(targetDir);
          const binSrc = path.resolve(targetDir, pkg.bin);
          const binDest = path.join(localBin, binName);
          if (fs.existsSync(binSrc)) {
            try {
              if (fs.existsSync(binDest)) fs.rmSync(binDest, { force: true });
              fs.symlinkSync(binSrc, binDest);
              fs.chmodSync(binSrc, 0o755);
              exposed.push(binName);
            } catch {}
          }
        } else if (pkg.bin && typeof pkg.bin === 'object') {
          for (const [binName, relPath] of Object.entries(pkg.bin)) {
            const binSrc = path.resolve(targetDir, relPath);
            const binDest = path.join(localBin, binName);
            if (fs.existsSync(binSrc)) {
              try {
                if (fs.existsSync(binDest)) fs.rmSync(binDest, { force: true });
                fs.symlinkSync(binSrc, binDest);
                fs.chmodSync(binSrc, 0o755);
                exposed.push(binName);
              } catch {}
            }
          }
        }
      } catch {}
    }

    // 2. Cargo target/release binaries
    const cargoRelease = path.join(targetDir, 'target', 'release');
    if (fs.existsSync(cargoRelease) && binaries) {
      for (const bin of binaries) {
        const binSrc = path.join(cargoRelease, bin);
        const binDest = path.join(localBin, bin);
        if (fs.existsSync(binSrc)) {
          try {
            if (fs.existsSync(binDest)) fs.rmSync(binDest, { force: true });
            fs.symlinkSync(binSrc, binDest);
            exposed.push(bin);
          } catch {}
        }
      }
    }

    return exposed;
  }

  /**
   * Execute package manager install and build steps as suggested by the repo
   */
  executeRepoSuggestions(targetDir, diagnostics, options = {}) {
    if (options.dryRun || options.skipBuild) {
      return { executed: false, commands: [], reason: 'dry_run or skip_build' };
    }

    const commandsRun = [];
    const method = diagnostics.detected?.installMethod;

    try {
      // Node.js projects
      if (['npm', 'yarn', 'pnpm', 'bun'].includes(method) || fs.existsSync(path.join(targetDir, 'package.json'))) {
        let cmd = 'npm install --prefer-offline --no-audit --no-fund';
        if (fs.existsSync(path.join(targetDir, 'pnpm-lock.yaml'))) {
          cmd = 'pnpm install --prefer-offline';
        } else if (fs.existsSync(path.join(targetDir, 'yarn.lock'))) {
          cmd = 'yarn install';
        } else if (fs.existsSync(path.join(targetDir, 'bun.lockb'))) {
          cmd = 'bun install';
        }

        try {
          execSync(cmd, { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
          commandsRun.push(cmd);
        } catch (e) {
          // If preferred manager not found, fallback to npm
          if (!cmd.startsWith('npm')) {
            try {
              execSync('npm install --prefer-offline --no-audit --no-fund', {
                cwd: targetDir,
                stdio: 'pipe',
                timeout: 120000
              });
              commandsRun.push('npm install');
            } catch {}
          }
        }

        // Build step if defined
        try {
          const pkg = JSON.parse(fs.readFileSync(path.join(targetDir, 'package.json'), 'utf8'));
          if (pkg.scripts && pkg.scripts.build && !options.skipScripts) {
            execSync('npm run build', { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
            commandsRun.push('npm run build');
          }
        } catch {}
      }

      // Python projects
      if (['pip', 'uv'].includes(method) || fs.existsSync(path.join(targetDir, 'requirements.txt')) || fs.existsSync(path.join(targetDir, 'pyproject.toml'))) {
        if (fs.existsSync(path.join(targetDir, 'requirements.txt'))) {
          try {
            execSync('pip install --no-cache-dir -r requirements.txt', { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
            commandsRun.push('pip install -r requirements.txt');
          } catch {}
        }
        if (fs.existsSync(path.join(targetDir, 'setup.py')) || fs.existsSync(path.join(targetDir, 'pyproject.toml'))) {
          try {
            execSync('pip install -e .', { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
            commandsRun.push('pip install -e .');
          } catch {}
        }
      }

      // Rust projects
      if (method === 'cargo' || fs.existsSync(path.join(targetDir, 'Cargo.toml'))) {
        try {
          execSync('cargo build --release', { cwd: targetDir, stdio: 'pipe', timeout: 180000 });
          commandsRun.push('cargo build --release');
        } catch {}
      }

      // Go projects
      if (method === 'go' || fs.existsSync(path.join(targetDir, 'go.mod'))) {
        try {
          execSync('go build ./...', { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
          commandsRun.push('go build ./...');
        } catch {}
      }
    } catch (e) {
      // Non-fatal: installation can still succeed with skills registered
    }

    return { executed: true, commands: commandsRun };
  }

  /**
   * Main install method
   */
  install(repoInput, options = {}) {
    const isJson = options.json;
    const norm = this.normalizeRepoUrl(repoInput);

    if (!isJson) {
      console.log(`\n✨ Enlighten v${this.version}`);
      console.log(`📦 Target Repository: ${norm.url}`);
      console.log(`🆔 Identifier: ${norm.identifier}\n`);
    }

    // Step 1: Check existing
    const existing = this.getInstalled().find(i => i.identifier === norm.identifier);
    if (existing && !options.force && !options.dryRun) {
      const msg = `Repository already installed at ${existing.install_dir}. Use --force to reinstall.`;
      if (isJson) {
        console.log(JSON.stringify({ status: 'already_installed', identifier: norm.identifier, install_dir: existing.install_dir }, null, 2));
      } else {
        console.log(`⚠️  ${msg}\n`);
      }
      return { status: 'already_installed', identifier: norm.identifier, install_dir: existing.install_dir };
    }

    // Step 2: Download or Clone
    const targetDir = path.join(this.reposDir, norm.owner, norm.repoName);
    if (!options.dryRun) {
      if (!isJson) console.log(`⏳ Step 1/4: Cloning repository into ${targetDir}...`);
      if (fs.existsSync(norm.url)) {
        // Local directory
        this.skillRegistry.linkOrCopy(path.resolve(norm.url), targetDir);
      } else {
        if (fs.existsSync(targetDir)) {
          fs.rmSync(targetDir, { recursive: true, force: true });
        }
        const parent = path.dirname(targetDir);
        if (!fs.existsSync(parent)) fs.mkdirSync(parent, { recursive: true });

        try {
          execSync(`git clone --depth 1 "${norm.url}" "${targetDir}"`, {
            stdio: 'pipe',
            timeout: 120000
          });
        } catch (e) {
          const errMsg = `Failed to clone repository: ${e.message}`;
          if (isJson) {
            console.log(JSON.stringify({ status: 'error', error: errMsg }, null, 2));
          } else {
            console.error(`❌ ${errMsg}`);
          }
          return { status: 'error', error: errMsg };
        }
      }
    }

    // Step 3: Scan repository
    if (!isJson) console.log(`🔍 Step 2/4: Scanning repository & detecting skills...`);
    const scanDir = options.dryRun && !fs.existsSync(targetDir) ? '/tmp' : targetDir;
    const diagnostics = this.scanner.scanRepo(scanDir);

    if (!isJson) {
      console.log(`   • Language: ${diagnostics.detected?.language || 'unknown'}`);
      console.log(`   • Framework: ${diagnostics.detected?.framework || 'generic'}`);
      console.log(`   • Profile: ${diagnostics.profile?.recommended || 'developer'}`);
    }

    // Step 4: Discover & Register Skills Globally
    if (!isJson) console.log(`🌐 Step 3/4: Registering skills into global agent directories...`);
    const skillsToRegister = [];
    if (diagnostics.skills?.found) {
      skillsToRegister.push(...diagnostics.skills.items);
    } else {
      // Synthesize a skill wrapper if repo has no SKILL.md
      const generatedSkill = this.skillRegistry.generateSkillForRepo(targetDir, {
        name: norm.repoName,
        repoUrl: norm.url,
        binaries: diagnostics.suggestions?.binaries
      });
      skillsToRegister.push(generatedSkill);
    }

    const registeredSkillsManifest = [];
    for (const skill of skillsToRegister) {
      const regResult = this.skillRegistry.registerSkill(skill, {
        repoUrl: norm.url,
        allHarnesses: true
      });
      registeredSkillsManifest.push({
        name: skill.name,
        path: skill.skillDir,
        registeredHarnesses: regResult.registeredHarnesses.map(h => h.harness)
      });
      if (!isJson) {
        console.log(`   ✅ Registered skill: "${skill.name}" across [${regResult.registeredHarnesses.map(h => h.harness).join(', ')}]`);
      }
    }

    // Register slash commands if present
    const commandsDir = path.join(targetDir, 'commands');
    const registeredCommands = this.skillRegistry.registerCommands(commandsDir);
    if (!isJson && registeredCommands.length > 0) {
      console.log(`   ✅ Registered slash commands: ${registeredCommands.map(c => c.file).join(', ')}`);
    }

    // Step 5: Execute suggestions (build, package manager, binary linking)
    if (!isJson) console.log(`⚡ Step 4/4: Executing repo setup & exposing binaries...`);
    const suggestionResult = this.executeRepoSuggestions(targetDir, diagnostics, options);
    const exposedBinaries = this.exposeBinaries(targetDir, diagnostics.suggestions?.binaries);

    if (!isJson && exposedBinaries.length > 0) {
      console.log(`   ✅ Exposed CLI binaries to ~/.local/bin: ${exposedBinaries.join(', ')}`);
    }

    // Step 6: Record in installed registry
    if (!options.dryRun) {
      const installed = this.getInstalled().filter(i => i.identifier !== norm.identifier);
      installed.push({
        identifier: norm.identifier,
        repo_url: norm.url,
        install_dir: targetDir,
        installed_at: new Date().toISOString(),
        profile: diagnostics.profile,
        detected: diagnostics.detected,
        skills_registered: registeredSkillsManifest,
        commands_run: suggestionResult.commands,
        exposed_binaries: exposedBinaries,
        version: this.version
      });
      this.saveInstalled(installed);
    }

    const result = {
      status: options.dryRun ? 'dry_run' : 'success',
      identifier: norm.identifier,
      repo_url: norm.url,
      install_dir: targetDir,
      profile: diagnostics.profile?.recommended,
      skills_registered: registeredSkillsManifest,
      exposed_binaries: exposedBinaries,
      commands_run: suggestionResult.commands
    };

    if (isJson) {
      console.log(JSON.stringify(result, null, 2));
    } else {
      console.log(`\n🎉 Installation Complete!`);
      console.log(`   • Skills Registered: ${registeredSkillsManifest.map(s => s.name).join(', ')}`);
      console.log(`   • Global Harnesses Updated: Antigravity, Open Agents, Claude Code, Hermes, etc.`);
      console.log(`   • Installed at: ${targetDir}`);
      console.log(`\n💡 The newly installed skills are immediately available to your AI agents!`);
    }

    return result;
  }

  /**
   * Safe removal of any enlighten-managed repository and its registered skills
   */
  uninstall(identifierInput, options = {}) {
    const isJson = options.json;
    const cleanId = identifierInput.trim().toLowerCase();

    const installed = this.getInstalled();
    const item = installed.find(i => i.identifier === cleanId || i.repo_url === identifierInput || i.identifier.endsWith(cleanId));

    if (!item) {
      const errMsg = `No installation found with identifier: "${identifierInput}"`;
      if (isJson) {
        console.log(JSON.stringify({ status: 'not_found', error: errMsg }, null, 2));
      } else {
        console.log(`\n❌ ${errMsg}\n`);
      }
      return { status: 'not_found' };
    }

    if (!isJson) {
      console.log(`\n🗑️  Enlighten Uninstaller`);
      console.log(`   Removing: ${item.identifier} (${item.repo_url})`);
      console.log(`   Installed at: ${item.install_dir}`);
    }

    if (options.dryRun) {
      if (!isJson) console.log(`\n⚠️  DRY RUN: No files or skills will be removed.\n`);
      return { status: 'dry_run', target: item.identifier };
    }

    if (!options.force && !isJson) {
      console.log(`\n⚠️  To safely remove this repository and all its registered skills, run:`);
      console.log(`    enlighten uninstall ${item.identifier} --force\n`);
      return { status: 'confirmation_required' };
    }

    // 1. Unregister all skills
    const uninstalledSkills = [];
    if (item.skills_registered && Array.isArray(item.skills_registered)) {
      for (const s of item.skills_registered) {
        const removedFrom = this.skillRegistry.unregisterSkill(s.name);
        uninstalledSkills.push({ name: s.name, removedFrom });
        if (!isJson) console.log(`   • Unregistered skill: "${s.name}"`);
      }
    }

    // 2. Remove exposed binaries
    if (item.exposed_binaries && Array.isArray(item.exposed_binaries)) {
      const localBin = path.join(this.homedir, '.local', 'bin');
      for (const bin of item.exposed_binaries) {
        const binPath = path.join(localBin, bin);
        if (fs.existsSync(binPath) || fs.lstatSync(binPath, { throwIfNoEntry: false })) {
          try {
            fs.rmSync(binPath, { force: true });
            if (!isJson) console.log(`   • Removed binary: ~/.local/bin/${bin}`);
          } catch {}
        }
      }
    }

    // 3. Delete repository directory
    if (item.install_dir && fs.existsSync(item.install_dir)) {
      try {
        fs.rmSync(item.install_dir, { recursive: true, force: true });
        if (!isJson) console.log(`   • Deleted repository directory: ${item.install_dir}`);
      } catch (e) {
        if (!isJson) console.warn(`   ⚠️ Could not delete directory: ${e.message}`);
      }
    }

    // 4. Update registry
    const remaining = installed.filter(i => i.identifier !== item.identifier);
    this.saveInstalled(remaining);

    if (isJson) {
      console.log(JSON.stringify({ status: 'success', identifier: item.identifier, uninstalledSkills }, null, 2));
    } else {
      console.log(`\n✅ Successfully uninstalled ${item.identifier}!\n`);
    }

    return { status: 'success', identifier: item.identifier };
  }

  /**
   * List all managed installations
   */
  listInstalled(options = {}) {
    const installed = this.getInstalled();
    if (options.json) {
      console.log(JSON.stringify({ installations: installed }, null, 2));
      return installed;
    }

    console.log(`\n📋 Enlighten Installed Repositories (${installed.length})\n`);
    if (installed.length === 0) {
      console.log(`No repositories currently installed.`);
      console.log(`Use "enlighten install <repo-url>" to install repositories and register skills.\n`);
      return installed;
    }

    installed.forEach(item => {
      const skills = (item.skills_registered || []).map(s => s.name).join(', ') || 'none';
      const date = item.installed_at ? new Date(item.installed_at).toLocaleString() : 'unknown';
      console.log(`• ${item.identifier}`);
      console.log(`  Repo: ${item.repo_url}`);
      console.log(`  Path: ${item.install_dir}`);
      console.log(`  Skills: ${skills}`);
      console.log(`  Installed: ${date}\n`);
    });

    return installed;
  }

  /**
   * Diagnose repository without installing
   */
  diagnose(repoInput, options = {}) {
    const isJson = options.json;
    const norm = this.normalizeRepoUrl(repoInput);
    const tempDir = path.join(os.tmpdir(), `enlighten-diag-${Date.now()}`);

    if (!isJson) {
      console.log(`\n🔍 Diagnosing: ${norm.url}...`);
    }

    try {
      if (fs.existsSync(norm.url)) {
        // Local path
        const result = this.scanner.scanRepo(path.resolve(norm.url));
        if (isJson) console.log(JSON.stringify(result, null, 2));
        else this.printDiagnostic(result);
        return result;
      }

      execSync(`git clone --depth 1 "${norm.url}" "${tempDir}"`, {
        stdio: 'pipe',
        timeout: 60000
      });

      const result = this.scanner.scanRepo(tempDir);
      result.repository = norm.url;

      try {
        fs.rmSync(tempDir, { recursive: true, force: true });
      } catch {}

      if (isJson) {
        console.log(JSON.stringify(result, null, 2));
      } else {
        this.printDiagnostic(result);
      }
      return result;
    } catch (e) {
      try {
        if (fs.existsSync(tempDir)) fs.rmSync(tempDir, { recursive: true, force: true });
      } catch {}
      const errRes = { status: 'error', error: e.message };
      if (isJson) console.log(JSON.stringify(errRes, null, 2));
      else console.error(`❌ Diagnostics failed: ${e.message}\n`);
      return errRes;
    }
  }

  printDiagnostic(result) {
    console.log(`\n📊 Diagnostic Report:`);
    console.log(`   • Language: ${result.detected?.language} (confidence: ${result.detected?.language_confidence})`);
    console.log(`   • Framework: ${result.detected?.framework}`);
    console.log(`   • Install Method: ${result.detected?.installMethod}`);
    console.log(`   • Recommended Profile: ${result.profile?.recommended}`);
    console.log(`   • Skills Found: ${result.skills?.count || 0}`);
    if (result.skills?.items?.length > 0) {
      result.skills.items.forEach(s => {
        console.log(`     - ${s.name}: ${s.description.slice(0, 80)}...`);
      });
    }
    if (result.suggestions?.binaries?.length > 0) {
      console.log(`   • Binaries: ${result.suggestions.binaries.join(', ')}`);
    }
    console.log('');
  }
}

// CLI Execution
if (require.main === module) {
  const args = process.argv.slice(2);
  const cli = new EnlightCLI({
    dryRun: args.includes('--dry-run')
  });

  const isJson = args.includes('--json');
  const isForce = args.includes('--force');
  const isDryRun = args.includes('--dry-run');

  const filteredArgs = args.filter(a => !a.startsWith('--'));

  if (filteredArgs.length === 0 || args.includes('--help') || args.includes('-h') || filteredArgs[0] === 'help') {
    console.log(`
Enlighten v${cli.version} - Universal AI Agent Repository & Skill Installer

USAGE:
    enlighten install <repo-url> [--dry-run] [--force] [--json]
    enlighten diagnose <repo-url> [--json]
    enlighten list-installed [--json]
    enlighten uninstall <identifier> [--force] [--dry-run] [--json]
    enlighten --help

COMMANDS:
    install <url>       Download/install any GitHub repository and automatically register
                        all its skills into global agent skill directories.
    diagnose <url>      Analyze repository without installing.
    list-installed      Show all managed installations and registered skills.
    uninstall <id>      Safely remove a repository and unregister its skills globally.

SUPPORTED AGENT HARNESSES:
    Antigravity / Gemini (~/.gemini/skills/)
    Open Agents (~/.agents/skills/)
    Claude Code (~/.claude/skills/)
    Hermes (~/.hermes/skills/)
    OpenCode (~/.config/opencode/skills/)
    Codex (~/.codex/skills/)
    Cursor (~/.cursor/skills/)
    Zed (~/.zed/skills/)
`);
    process.exit(0);
  }

  const cmd = filteredArgs[0].toLowerCase();
  const target = filteredArgs[1];

  switch (cmd) {
    case 'install':
      if (!target) {
        console.error('Error: repository URL or shorthand required (e.g., enlighten install owner/repo)');
        process.exit(1);
      }
      cli.install(target, { json: isJson, force: isForce, dryRun: isDryRun });
      break;

    case 'diagnose':
      if (!target) {
        console.error('Error: repository URL required');
        process.exit(1);
      }
      cli.diagnose(target, { json: isJson });
      break;

    case 'list':
    case 'list-installed':
    case 'ls':
      cli.listInstalled({ json: isJson });
      break;

    case 'uninstall':
    case 'remove':
    case 'rm':
      if (!target) {
        console.error('Error: identifier required (use "enlighten list-installed" to see identifiers)');
        process.exit(1);
      }
      cli.uninstall(target, { json: isJson, force: isForce, dryRun: isDryRun });
      break;

    default:
      console.error(`Unknown command: "${cmd}". Run "enlighten --help" for usage.`);
      process.exit(1);
  }
}

module.exports = { EnlightCLI };
